+// Synthetic view-only fixture, not a market record or direction inference.
+export function mobileWatch(){
+ const H=3600000,anchor=Date.UTC(2026,9,18,8),slots=Array.from({length:4},(_,i)=>({scheduledAt:anchor-(3-i)*H,runId:`hourly_20261018_${String(13+i).padStart(2,'0')}00`,status:i===1?'PARTIAL':'COMPLETE',finishedAt:anchor-(3-i)*H+120000,dataCutoff:anchor-(3-i)*H+10000,selectedCount:10,validResearchCount:10,coverage:'COMPLETE'}));
+ const items=Array.from({length:12},(_,i)=>{const symbol=i===0?'GTCUSDT':i===1?'LONG'+'A'.repeat(30)+'USDT':`MOCK${i}USDT`,occurrences=slots.map((s,j)=>({runId:s.runId,scheduledAt:s.scheduledAt,researchTime:s.scheduledAt+60000,dataCutoff:s.dataCutoff,score:93.94-i,scoreStatus:'AVAILABLE',bias:['BEARISH','BEARISH','NO_EDGE','BULLISH'][j],anomalyTypes:['PRICE_1H','OI_4H','FUNDING_CHANGE'],metrics:{price1h:{value:String(j+1),unit:'%'},oi1h:{value:String(j*2),unit:'%'},fundingSettled:{value:'.01',unit:'%'}}}));return {symbol,highestScore:93.94-i,scoreStatus:'AVAILABLE',latestBias:'BULLISH',latestRunId:slots[3].runId,firstSeenAt:slots[0].scheduledAt,latestResearchAt:occurrences[3].researchTime,dataCutoff:slots[3].dataCutoff,occurrenceCount:4,anomalyTypes:['PRICE_1H','PRICE_24H','OI_4H','FUNDING_CHANGE','ACCOUNT_DISTRIBUTION_SHIFT'],occurrences};});
+ return {version:'4H_MARKET_WATCH_V1',timeZone:'Asia/Shanghai',expectedSlots:4,windowStart:slots[0].scheduledAt,windowEnd:anchor,observedAt:anchor+600000,counts:{completed:4,complete:3,partial:1,failed:0,missing:0,skipped:0,running:0,incomplete:0,invalid:0},lastValidScanAt:slots[3].dataCutoff,slots,items,totalSymbols:12,stale:false};
+}
