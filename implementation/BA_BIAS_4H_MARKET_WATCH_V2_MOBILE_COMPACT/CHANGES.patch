+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';
+import {watchBiasMark,watchHistory,compactWatchTime,compactAnomalyLabels,orderedWatchSlots,compactWatch,marketWatchView} from '../web/assets/presentation.js';import {BIASES} from '../src/analysis/market-bias-v2/render.js';import {publicDTO} from '../src/web/public-dto.js';import {mobileWatch} from './market-watch-mobile-fixture.js';
+for(const [bias,mark] of [['BULLISH','L'],['BEARISH','S'],['NO_EDGE','N']])test('actual V2 enum '+bias+' maps only to '+mark,()=>{assert(Object.hasOwn(BIASES,bias));assert.equal(watchBiasMark(bias),mark);});
+for(const bias of [null,undefined,'UNKNOWN','FAILED','BULL','BEAR','BULLISH_REVERSAL','constructor','toString'])test(String(bias)+' is unknown, never NO_EDGE',()=>assert.equal(watchBiasMark(bias),'?'));
+test('all four hours are chronological despite newest-first occurrence array',()=>{const w=mobileWatch(),r=w.items[0];r.occurrences.reverse();assert.equal(watchHistory(r,w.slots).map(x=>x.mark).join(''),'SSNL');assert.deepEqual(watchHistory(r,w.slots).map(x=>x.runId),w.slots.map(x=>x.runId));});
+test('a missing hour is not forward-filled or replaced by latest bias',()=>{const w=mobileWatch(),r=w.items[0];r.occurrences.splice(1,1);r.latestBias='NO_EDGE';assert.equal(watchHistory(r,w.slots).map(x=>x.mark).join(''),'S—NL');assert.equal(watchHistory(r,w.slots)[1].state,'PARTIAL_NO_VALID_RESEARCH');});
+test('completed no research is distinct from real NO_EDGE',()=>{const w=mobileWatch(),r=w.items[0];r.occurrences.splice(0,1);const h=watchHistory(r,w.slots);assert.equal(h[0].mark,'—');assert.equal(h[0].state,'NO_VALID_RESEARCH');assert.equal(h[2].mark,'N');assert.equal(h[2].state,'VALID_RESEARCH');});
+for(const status of ['FAILED','INTERRUPTED','SKIPPED_MISSED','SKIPPED_OVERLAP','MISSING','RUNNING','INCOMPLETE','INVALID'])test(status+' cannot release provisional direction or map to N',()=>{const w=mobileWatch();w.slots[0].status=status;const h=watchHistory(w.items[0],w.slots)[0];assert.equal(h.mark,'—');assert.equal(h.state,'SLOT_UNAVAILABLE');assert.equal(h.bias,null);});
+test('PARTIAL slot can show its actual valid direction',()=>{const w=mobileWatch();assert.equal(watchHistory(w.items[0],w.slots)[1].mark,'S');});
+test('sourceRunId and scheduledAt must both match',()=>{const w=mobileWatch();w.items[0].occurrences[0].runId='FOREIGN_RUN';assert.equal(watchHistory(w.items[0],w.slots)[0].mark,'—');});
+test('same-slot duplicate chooses newest actual researchTime and keeps its source',()=>{const w=mobileWatch(),r=w.items[0],o={...r.occurrences[0],researchTime:r.occurrences[0].researchTime+1,bias:'NO_EDGE'};r.occurrences.push(o);const h=watchHistory(r,w.slots);assert.equal(h[0].mark,'N');assert.equal(h[0].researchTime,o.researchTime);assert.equal(h[0].runId,o.runId);});
+test('unknown saved direction retains raw meaning as ?, never S/L/N',()=>{const w=mobileWatch();w.items[0].occurrences[0].bias='NEW_STATE';const h=watchHistory(w.items[0],w.slots)[0];assert.equal(h.mark,'?');assert.equal(h.bias,'NEW_STATE');assert.match(h.label,/NEW_STATE/);});
+test('direction changes stay per hour; score/price/anomaly changes cannot change marks',()=>{const w=mobileWatch(),r=w.items[0],before=watchHistory(r,w.slots).map(x=>x.mark);r.highestScore=0;r.latestBias='BEARISH';r.anomalyTypes=['FUNDING_EXTREME'];for(const o of r.occurrences)o.metrics={price1h:{value:'-99'}};assert.deepEqual(watchHistory(r,w.slots).map(x=>x.mark),before);});
+test('default Top10 preserves API order and original exact scores',()=>{const w=mobileWatch(),before=structuredClone(w);assert.deepEqual(marketWatchView(w).items.map(x=>x.symbol),w.items.slice(0,10).map(x=>x.symbol));assert.equal(compactWatch.score(w.items[0].highestScore),'93.9');assert.equal(w.items[0].highestScore,93.94);assert.equal(compactWatch.score(0),'0.0');assert.equal(compactWatch.score(null),'—');assert.deepEqual(w,before);});
+test('time compaction uses UTC+8, same-day HH:mm and cross-day MM/DD HH:mm',()=>{const ref=Date.UTC(2026,9,18,8,10);assert.equal(compactWatchTime(Date.UTC(2026,9,18,8,1),ref),'16:01');assert.equal(compactWatchTime(Date.UTC(2026,9,17,15,1),ref),'10/17 23:01');assert.equal(compactWatchTime(null,ref),'—');assert.equal(compactWatchTime(NaN,ref),'—');});
+test('midnight timezone and immutable original timestamps',()=>{const t=Date.UTC(2026,9,17,16,1),r=Date.UTC(2026,9,18,1);assert.equal(compactWatchTime(t,r),'00:01');assert.equal(t,Date.UTC(2026,9,17,16,1));});
+test('anomaly labels collapse display families without editing raw facts',()=>{const a=['PRICE_1H','PRICE_4H','PRICE_24H','FUNDING_EXTREME','FUNDING_CHANGE','FUNDING_FLIP','OI_4H','VOLUME_SPIKE','ACCOUNT_DISTRIBUTION_SHIFT','TOP_ACCOUNT_DISTRIBUTION_SHIFT','ACCOUNT_DOMINANCE_FLIP','TOP_GLOBAL_DIVERGENCE','TOP_POSITION_DISTRIBUTION_SHIFT','NEW_EVENT'],before=[...a];assert.deepEqual(compactAnomalyLabels(a),['价格','资金费率','持仓量','成交量','账户分布','顶部持仓','NEW_EVENT']);assert.deepEqual(a,before);});
+test('display adapters mutate neither hourly records nor slot arrays',()=>{const w=mobileWatch(),before=structuredClone(w);watchHistory(w.items[0],w.slots);orderedWatchSlots(w.slots);compactAnomalyLabels(w.items[0].anomalyTypes);assert.deepEqual(w,before);});
+test('unchanged public DTO retains four hourly bias sources and strips poison fields',()=>{const w=mobileWatch();w.items[0].occurrences[0].rawResponse='DO_NOT_RELEASE';w.items[0].providerHeaders={Authorization:'DO_NOT_RELEASE'};const d=publicDTO().overview({marketWatch:w});assert(!JSON.stringify(d).includes('DO_NOT_RELEASE'));assert.equal(watchHistory(d.marketWatch.items[0],d.marketWatch.slots).map(x=>x.mark).join(''),'SSNL');});
+test('native summary handles keyboard; toggle updates explicit expanded state',async()=>{const s=await fs.readFile(new URL('../web/assets/app.js',import.meta.url),'utf8');assert(s.includes("E('details',null,'watch-item')"));assert(s.includes("E('summary',null,'watch-summary')"));assert(s.includes("setAttribute('aria-expanded','false')"));assert(s.includes("addEventListener('toggle',()=>summary.setAttribute('aria-expanded',String(c.open)))"));assert(s.includes('Latest Scan · 最近一轮扫描'));assert(s.includes('查看最新完整研究'));});
