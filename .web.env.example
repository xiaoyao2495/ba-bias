# Copy to .web.env. Keep your existing business .env unchanged.
BA_BIAS_WEB_HOST=127.0.0.1
BA_BIAS_WEB_PORT=8787
BA_BIAS_WEB_ORIGIN=http://127.0.0.1:8787
# Generate using npm run web:password, then paste the complete output line.
BA_BIAS_WEB_PASSWORD_HASH=replace_with_generated_scrypt_hash
# Optional: read a separate copy of production records
# BA_DATA_DIR=D:\ba-bias\data
# Private remote access requires explicit opt-in and authentication.
# BA_BIAS_WEB_ALLOW_REMOTE=1
# BA_BIAS_WEB_PRIVATE_NETWORK=1
# For HTTPS reverse proxy: BA_BIAS_WEB_ORIGIN=https://your-dashboard.example

# Default/private mode retains login. Only the exact value 1 enables public mode.
# BA_BIAS_WEB_PUBLIC_READONLY=0
# Anonymous public HTTP (requires your actual origin; keep any existing hash):
# BA_BIAS_WEB_PUBLIC_READONLY=1
# BA_BIAS_WEB_ALLOW_REMOTE=1
# BA_BIAS_WEB_HOST=0.0.0.0
# BA_BIAS_WEB_ORIGIN=http://PUBLIC_IP:8787
