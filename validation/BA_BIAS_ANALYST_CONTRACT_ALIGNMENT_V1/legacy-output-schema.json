{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "symbol",
    "evaluationTime",
    "marketBias",
    "horizon",
    "horizonReason",
    "conviction",
    "marketThesis",
    "marketMechanism",
    "supportingEvidenceIds",
    "conflictingEvidenceIds",
    "tradeOpportunity",
    "preferredScenario",
    "invalidation",
    "alternativeScenario",
    "followUpChecks"
  ],
  "properties": {
    "version": {
      "const": "DIRECTIONAL_ANALYST_V1"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "evaluationTime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "marketBias": {
      "enum": [
        "BULLISH",
        "BEARISH",
        "BULLISH_REVERSAL",
        "BEARISH_REVERSAL",
        "NO_EDGE"
      ]
    },
    "horizon": {
      "enum": [
        "1h",
        "4h",
        "24h"
      ]
    },
    "horizonReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "conviction": {
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH"
      ]
    },
    "marketThesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "marketMechanism": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "supportingEvidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 8,
      "uniqueItems": true,
      "minItems": 1
    },
    "conflictingEvidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "tradeOpportunity": {
      "enum": [
        "LONG_SETUP",
        "SHORT_SETUP",
        "WAIT_FOR_PULLBACK",
        "WAIT_FOR_CONFIRMATION",
        "AVOID_CHASING",
        "NO_ACTIONABLE_SETUP"
      ]
    },
    "preferredScenario": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "OBSERVABLE_CONDITION"
              }
            }
          },
          "then": {
            "properties": {
              "ruleIds": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "ruleIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ],
      "required": [
        "type",
        "ruleIds",
        "description"
      ],
      "properties": {
        "type": {
          "enum": [
            "OBSERVABLE_CONDITION",
            "INSUFFICIENT_STRUCTURE_DATA"
          ]
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "alternativeScenario": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "followUpChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "minItems": 1,
      "maxItems": 2
    }
  }
}
