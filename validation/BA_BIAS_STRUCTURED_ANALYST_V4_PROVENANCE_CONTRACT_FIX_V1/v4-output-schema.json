{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "provenance",
    "causalBacktestEligible",
    "symbol",
    "evaluationTime",
    "direction",
    "horizon",
    "conviction",
    "supportingEvidenceIds",
    "conflictingEvidenceIds",
    "structureEvidenceIds",
    "mechanismHypothesis",
    "directionalRationale",
    "tradeOpportunity",
    "reassessmentConditions"
  ],
  "properties": {
    "version": {
      "const": "STRUCTURED_ANALYST_V4_EXPERIMENT"
    },
    "status": {
      "const": "NOT_PRODUCTION"
    },
    "provenance": {
      "const": "SYNTHETIC_OR_CONVERTED"
    },
    "causalBacktestEligible": {
      "const": false
    },
    "symbol": {
      "type": "string"
    },
    "evaluationTime": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "BULLISH",
        "BEARISH",
        "BULLISH_REVERSAL",
        "BEARISH_REVERSAL",
        "NO_EDGE"
      ]
    },
    "horizon": {
      "enum": [
        "1h",
        "4h",
        "24h"
      ]
    },
    "conviction": {
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH"
      ]
    },
    "supportingEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "conflictingEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structureEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mechanismHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "evidenceIds",
        "limitation"
      ],
      "properties": {
        "type": {
          "enum": [
            "CO_MOVEMENT_ONLY",
            "CONTRACT_EXPANSION_COMPATIBLE",
            "CONTRACT_CONTRACTION_COMPATIBLE",
            "UNDETERMINED"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitation": {
          "const": "PARTICIPANT_BEHAVIOR_UNCONFIRMED"
        }
      }
    },
    "directionalRationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "evidenceIds",
        "alternative",
        "certainty"
      ],
      "properties": {
        "hypothesis": {
          "enum": [
            "CONTINUATION",
            "TURN",
            "COUNTER_MOVE",
            "NO_CLEAR_EDGE"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "alternative": {
          "enum": [
            "OPPOSITE_MOVE",
            "CONSOLIDATION",
            "CONTINUATION"
          ]
        },
        "certainty": {
          "const": "CONDITIONAL_NOT_CONFIRMED"
        }
      }
    },
    "tradeOpportunity": {
      "enum": [
        "WAIT_FOR_CONFIRMATION",
        "WAIT_FOR_PULLBACK",
        "NO_ACTIONABLE_SETUP",
        "LONG_SETUP",
        "SHORT_SETUP"
      ]
    },
    "reassessmentConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conditionType",
              "ruleId"
            ],
            "properties": {
              "conditionType": {
                "const": "PROGRAM_RULE"
              },
              "ruleId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conditionType",
              "metricOrStructureEvidenceId",
              "interpretation",
              "consequence"
            ],
            "properties": {
              "conditionType": {
                "const": "ABSTRACT_REASSESSMENT"
              },
              "metricOrStructureEvidenceId": {
                "type": "string"
              },
              "interpretation": {
                "const": "MONITOR_CHANGE"
              },
              "consequence": {
                "const": "REASSESS_ONLY"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conditionType",
              "metricOrStructureEvidenceId",
              "operator",
              "consequence"
            ],
            "properties": {
              "conditionType": {
                "const": "STRUCTURE_BOUNDARY"
              },
              "metricOrStructureEvidenceId": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "LTE",
                  "GTE"
                ]
              },
              "consequence": {
                "enum": [
                  "REASSESS_ONLY",
                  "INVALIDATED"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conditionType",
              "consequence"
            ],
            "properties": {
              "conditionType": {
                "const": "INSUFFICIENT_STRUCTURE_DATA"
              },
              "consequence": {
                "const": "NO_MECHANICAL_INVALIDATION"
              }
            }
          }
        ]
      }
    }
  }
}
